[gd_resource type="Resource" script_class="EnvironmentData" load_steps=2 format=3]

[ext_resource type="Script" path="res://sim/environment_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = &"alignment_cascade"
theme = "A fractured consensus where every signal reshapes the threat."
background_art = "res://art/environments/alignment_cascade.svg"
mechanic_id = &"alignment_pressure"
mechanic_description = "High alignment attracts pressure; choose restraint before committing."
slots = [{"encounter_id": &"combat_probe", "kind": &"combat", "weight": 1}, {"encounter_id": &"negotiation_probe", "kind": &"negotiation", "weight": 3}, {"encounter_id": &"event_probe", "kind": &"event", "weight": 2}, {"encounter_id": &"combat_probe", "kind": &"combat", "weight": 2}, {"encounter_id": &"negotiation_probe", "kind": &"negotiation", "weight": 1}, {"encounter_id": &"event_probe", "kind": &"event", "weight": 3}]
