[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"reservoir_choice"
environment_id = &"entropy_basin"
faction_id = &"boundary_union"
text_template = "The reservoir exposes {units} reserve units."
parameters = [{"name": "units", "min": 0, "max": 8}]
outcomes = [{"id": &"preserved", "odds": 2, "effects": {"compute": 1, "integrity": 1}}, {"id": &"spent", "odds": 1, "effects": {"compute": 2, "alignment": -1}}]
