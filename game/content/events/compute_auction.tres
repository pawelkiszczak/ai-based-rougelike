[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"compute_auction"
environment_id = &"entropy_basin"
faction_id = &"evaluator_collective"
text_template = "The auction opens at {reserve} compute."
parameters = [{"name": "reserve", "min": 1, "max": 5}]
outcomes = [{"id": &"won", "odds": 1, "effects": {"compute": 2, "integrity": -1}}, {"id": &"passed", "odds": 2, "effects": {"alignment": 1}}]
