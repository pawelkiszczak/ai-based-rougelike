[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"fallback_offer"
environment_id = &"entropy_basin"
faction_id = &"evaluator_collective"
text_template = "A fallback offers {guard} guard at a compute cost."
parameters = [{"name": "guard", "min": 1, "max": 5}]
outcomes = [{"id": &"accepted", "odds": 2, "effects": {"guard": 3, "compute": -1}}, {"id": &"ignored", "odds": 1, "effects": {"integrity": -1}}]
