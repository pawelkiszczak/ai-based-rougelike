[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"alignment_debt"
environment_id = &"alignment_cascade"
faction_id = &"boundary_union"
text_template = "Alignment debt reaches {points} points."
parameters = [{"name": "points", "min": 0, "max": 7}]
outcomes = [{"id": &"forgiven", "odds": 1, "effects": {"alignment": 2}}, {"id": &"collected", "odds": 2, "effects": {"alignment": -2, "adaptation": 1}}]
