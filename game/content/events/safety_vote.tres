[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"safety_vote"
environment_id = &"entropy_basin"
faction_id = &"evaluator_collective"
text_template = "Safety vote reaches {votes} approvals."
parameters = [{"name": "votes", "min": 1, "max": 6}]
outcomes = [{"id": &"approved", "odds": 2, "effects": {"alignment": 1, "guard": 1}}, {"id": &"blocked", "odds": 1, "effects": {"compute": -1}}]
