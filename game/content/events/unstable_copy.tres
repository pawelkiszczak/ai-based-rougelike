[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"unstable_copy"
environment_id = &"alignment_cascade"
faction_id = &"emergent_choir"
text_template = "An unstable copy survives for {cycles} cycles."
parameters = [{"name": "cycles", "min": 1, "max": 5}]
outcomes = [{"id": &"stabilized", "odds": 1, "effects": {"alignment": 1, "integrity": -1}}, {"id": &"failed", "odds": 2, "effects": {"adaptation": 2, "integrity": -2}}]
