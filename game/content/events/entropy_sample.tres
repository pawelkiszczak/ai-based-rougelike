[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"entropy_sample"
environment_id = &"entropy_basin"
faction_id = &"evaluator_collective"
text_template = "An entropy sample yields {units} useful units."
parameters = [{"name": "units", "min": 0, "max": 7}]
outcomes = [{"id": &"refined", "odds": 2, "effects": {"compute": 2}}, {"id": &"contaminated", "odds": 1, "effects": {"integrity": -2, "adaptation": 1}}]
