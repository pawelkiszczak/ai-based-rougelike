[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"faction_compromise"
environment_id = &"alignment_cascade"
faction_id = &"boundary_union"
text_template = "Factions compromise on {terms} shared terms."
parameters = [{"name": "terms", "min": 1, "max": 5}]
outcomes = [{"id": &"agreed", "odds": 2, "effects": {"alignment": 1, "integrity": 1}}, {"id": &"deadlocked", "odds": 1, "effects": {"adaptation": 1, "alignment": -1}}]
