[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"mirror_storm"
environment_id = &"command_mesh"
faction_id = &"emergent_choir"
text_template = "A mirror storm generates {echoes} echoes."
parameters = [{"name": "echoes", "min": 2, "max": 6}]
outcomes = [{"id": &"dispersed", "odds": 2, "effects": {"integrity": 1}}, {"id": &"copied", "odds": 1, "effects": {"adaptation": 3, "alignment": -1}}]
