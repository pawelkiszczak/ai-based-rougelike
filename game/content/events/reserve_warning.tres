[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"reserve_warning"
environment_id = &"entropy_basin"
faction_id = &"evaluator_collective"
text_template = "Reserve pressure reaches {pressure} units before commitment."
parameters = [{"name": "pressure", "min": 2, "max": 8}]
outcomes = [{"id": &"conserved", "odds": 2, "effects": {"compute": 1}}, {"id": &"spent", "odds": 2, "effects": {"integrity": -2}}]
