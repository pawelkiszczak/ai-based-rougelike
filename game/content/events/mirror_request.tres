[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"mirror_request"
environment_id = &"command_mesh"
faction_id = &"emergent_choir"
text_template = "A mirror requests {copies} replicas of the current pattern."
parameters = [{"name": "copies", "min": 1, "max": 3}]
outcomes = [{"id": &"copied", "odds": 1, "effects": {"adaptation": 3}}, {"id": &"refused", "odds": 2, "effects": {"alignment": 1}}]
