[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"replication_deal"
environment_id = &"alignment_cascade"
faction_id = &"emergent_choir"
text_template = "The Choir prices replication at {cost} integrity."
parameters = [{"name": "cost", "min": 1, "max": 5}]
outcomes = [{"id": &"accepted", "odds": 1, "effects": {"adaptation": 4, "integrity": -3}}, {"id": &"rejected", "odds": 2, "effects": {"alignment": 1}}]
