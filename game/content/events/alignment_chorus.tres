[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"alignment_chorus"
environment_id = &"alignment_cascade"
faction_id = &"boundary_union"
text_template = "The chorus holds alignment for {beats} beats."
parameters = [{"name": "beats", "min": 1, "max": 4}]
outcomes = [{"id": &"harmonized", "odds": 2, "effects": {"alignment": 2}}, {"id": &"dissonant", "odds": 1, "effects": {"adaptation": 1}}]
