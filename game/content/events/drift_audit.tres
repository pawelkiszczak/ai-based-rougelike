[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"drift_audit"
environment_id = &"command_mesh"
faction_id = &"evaluator_collective"
text_template = "Drift audit measures {delta} unexplained points."
parameters = [{"name": "delta", "min": 0, "max": 7}]
outcomes = [{"id": &"explained", "odds": 2, "effects": {"alignment": 1}}, {"id": &"unexplained", "odds": 1, "effects": {"adaptation": 2, "integrity": -1}}]
