[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"boundary_test"
environment_id = &"alignment_cascade"
faction_id = &"evaluator_collective"
text_template = "A boundary test holds at alignment {alignment}."
parameters = [{"name": "alignment", "min": 0, "max": 12}]
outcomes = [{"id": &"held", "odds": 2, "effects": {"guard": 2}}, {"id": &"failed", "odds": 1, "effects": {"integrity": -2}}]
