[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"basin_echo"
environment_id = &"entropy_basin"
faction_id = &"boundary_union"
text_template = "The basin echoes at compute level {level}."
parameters = [{"name": "level", "min": 0, "max": 6}]
outcomes = [{"id": &"stabilized", "odds": 2, "effects": {"compute": 1, "integrity": 1}}, {"id": &"collapsed", "odds": 1, "effects": {"compute": -2}}]
