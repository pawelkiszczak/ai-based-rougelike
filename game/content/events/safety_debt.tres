[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"safety_debt"
environment_id = &"entropy_basin"
faction_id = &"evaluator_collective"
text_template = "Safety debt reaches {debt} points."
parameters = [{"name": "debt", "min": 0, "max": 8}]
outcomes = [{"id": &"repaid", "odds": 1, "effects": {"compute": -2, "integrity": 2}}, {"id": &"deferred", "odds": 2, "effects": {"adaptation": 2}}]
