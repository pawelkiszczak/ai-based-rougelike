[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"consensus_break"
environment_id = &"alignment_cascade"
faction_id = &"boundary_union"
text_template = "Consensus breaks after {votes} conflicting votes."
parameters = [{"name": "votes", "min": 2, "max": 6}]
outcomes = [{"id": &"reconciled", "odds": 1, "effects": {"alignment": 2}}, {"id": &"fractured", "odds": 2, "effects": {"alignment": -2, "adaptation": 1}}]
