[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"compute_window"
environment_id = &"entropy_basin"
faction_id = &"evaluator_collective"
text_template = "A compute window stays open for {cycles} cycles."
parameters = [{"name": "cycles", "min": 1, "max": 3}]
outcomes = [{"id": &"saved", "odds": 2, "effects": {"compute": 2}}, {"id": &"burned", "odds": 1, "effects": {"compute": -1, "integrity": -1}}]
