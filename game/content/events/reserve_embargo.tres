[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"reserve_embargo"
environment_id = &"entropy_basin"
faction_id = &"boundary_union"
text_template = "Reserve embargo withholds {units} units."
parameters = [{"name": "units", "min": 1, "max": 6}]
outcomes = [{"id": &"released", "odds": 1, "effects": {"compute": 2}}, {"id": &"withheld", "odds": 2, "effects": {"alignment": -1, "integrity": 1}}]
