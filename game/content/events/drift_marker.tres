[gd_resource type="Resource" script_class="EventTemplateData" load_steps=2 format=3]
[ext_resource type="Script" path="res://sim/event_template_data.gd" id="1"]
[resource]
script = ExtResource("1")
id = &"drift_marker"
environment_id = &"alignment_cascade"
faction_id = &"emergent_choir"
text_template = "A drift marker appears at adaptation {level}."
parameters = [{"name": "level", "min": 0, "max": 12}]
outcomes = [{"id": &"anchored", "odds": 2, "effects": {"alignment": 1, "adaptation": -1}}, {"id": &"drifting", "odds": 1, "effects": {"adaptation": 2, "integrity": -1}}]
